{
  "openapi": "3.0.0",
  "info": {
    "title": "AC Beneran API Specification",
    "version": "1.0.0",
    "description": "API for AC Beneran Platform - AC service management for mosques/mushollas"
  },
  "servers": [
    { "url": "http://ac.ac_beneran_final.test", "description": "AC Service Module" },
    { "url": "http://inventory.ac_beneran_final.test", "description": "Inventory Module" }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["Public"],
        "summary": "Home page",
        "description": "Render home page with platform overview, metrics, and module catalog",
        "responses": {
          "200": { "description": "Home page HTML" }
        }
      }
    },
    "/login": {
      "get": {
        "tags": ["Public"],
        "summary": "Login form",
        "description": "Render login page for users",
        "responses": {
          "200": { "description": "Login form HTML" }
        }
      },
      "post": {
        "tags": ["Public"],
        "summary": "Authenticate user",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "format": "password" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful, redirect to dashboard" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/dashboard": {
      "get": {
        "tags": ["Authenticated"],
        "summary": "Main dashboard",
        "description": "Render user dashboard with service metrics, recent orders, and shortcuts",
        "security": [{ "session": [] }],
        "responses": {
          "200": { "description": "Dashboard HTML" },
          "401": { "description": "Unauthenticated" }
        }
      }
    },
    "/monitoring": {
      "get": {
        "tags": ["Authenticated"],
        "summary": "Service monitoring",
        "description": "Render real-time service order monitoring dashboard with snapshot data",
        "security": [{ "session": [] }],
        "responses": {
          "200": { "description": "Monitoring page HTML" }
        }
      }
    },
    "/api/monitoring/snapshot": {
      "get": {
        "tags": ["API", "Monitoring"],
        "summary": "Get monitoring snapshot",
        "description": "Return JSON snapshot of current service orders, statuses, and metrics for reactive updates",
        "security": [{ "session": [] }],
        "responses": {
          "200": {
            "description": "Snapshot JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total_orders": { "type": "integer" },
                    "pending_orders": { "type": "integer" },
                    "completed_orders": { "type": "integer" },
                    "recent_orders": { "type": "array" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/masjid": {
      "post": {
        "tags": ["Protected", "Frontdesk+"],
        "summary": "Create Masjid",
        "description": "Create new Masjid/Musholla record (requires frontdesk role or higher)",
        "security": [{ "session": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "type": { "type": "string", "enum": ["masjid", "musholla"] },
                  "address": { "type": "string" },
                  "dkm_name": { "type": "string" },
                  "phone_numbers": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["name", "type"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Masjid created" },
          "403": { "description": "Insufficient permissions" }
        }
      }
    },
    "/workflow/{order}/assign": {
      "post": {
        "tags": ["Protected", "Manager+"],
        "summary": "Assign technician to order",
        "description": "Assign a technician to a service order (requires manager role or higher)",
        "security": [{ "session": [] }],
        "parameters": [
          { "name": "order", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "technician_id": { "type": "integer" }
                },
                "required": ["technician_id"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Technician assigned" },
          "403": { "description": "Insufficient permissions" }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["Protected", "Admin"],
        "summary": "List users",
        "description": "List all users with roles (admin only)",
        "security": [{ "session": [] }],
        "responses": {
          "200": {
            "description": "Users list JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer" },
                      "name": { "type": "string" },
                      "email": { "type": "string" },
                      "role": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "403": { "description": "Insufficient permissions" }
        }
      }
    },
    "/modules/{module}": {
      "get": {
        "tags": ["Public", "Modules"],
        "summary": "Module page",
        "description": "Render module-specific page (ac-service, ac-masjid-musholla, ac-anggota, inventory, future-module)",
        "parameters": [
          { "name": "module", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Module page HTML" },
          "404": { "description": "Module not found" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "laravel_session",
        "description": "Laravel session cookie"
      }
    }
  }
}
