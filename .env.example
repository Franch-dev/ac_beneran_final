APP_NAME="Forkis Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://main.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=main
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=main_platform
DB_USERNAME=root
DB_PASSWORD=

MAIN_DB_HOST=127.0.0.1
MAIN_DB_PORT=3306
MAIN_DB_DATABASE=main_platform
MAIN_DB_USERNAME=root
MAIN_DB_PASSWORD=

AC_SERVICE_DB_HOST=127.0.0.1
AC_SERVICE_DB_PORT=3306
AC_SERVICE_DB_DATABASE=ac_service_db
AC_SERVICE_DB_USERNAME=root
AC_SERVICE_DB_PASSWORD=

INVENTORY_DB_HOST=127.0.0.1
INVENTORY_DB_PORT=3306
INVENTORY_DB_DATABASE=inventory_db
INVENTORY_DB_USERNAME=root
INVENTORY_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_CONNECTION=main
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave empty unless you share sessions across subdomains. Must match your browser host:
# e.g. app at http://foo.test → use SESSION_DOMAIN=.foo.test; at http://localhost → leave empty.
SESSION_DOMAIN=
# On http:// locally leave SECURE empty/false. SameSite=none requires Secure; use lax locally.
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

AC_SERVICE_DOMAIN=ac.main.test
AC_MASJID_MUSHOLLA_DOMAIN=
AC_ANGGOTA_DOMAIN=
INVENTORY_DOMAIN=inventory.main.test
FUTURE_MODULE_DOMAIN=future.main.test

# Shared session cookie across subdomains (SSO-style): set leading dot, e.g. .main.test
# SESSION_DOMAIN is already set above — keep parent domain consistent with all module hosts.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
