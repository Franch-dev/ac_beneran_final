APP_NAME="Forkis Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=

# ... rest of .env.example unchanged, no secrets here

APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Four logical databases: main_platform, ac_masjid_db, ac_anggota_db, inventory_db
DB_CONNECTION=main
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=main_platform
DB_USERNAME=root
DB_PASSWORD=

MAIN_DB_HOST=127.0.0.1
MAIN_DB_PORT=3306
MAIN_DB_CONNECTION=mysql
MAIN_DB_DATABASE=main_platform
MAIN_DB_USERNAME=root
MAIN_DB_PASSWORD=

AC_SERVICE_DB_HOST=127.0.0.1
AC_SERVICE_DB_PORT=3306
AC_SERVICE_DB_CONNECTION=mysql
AC_SERVICE_DB_DATABASE=ac_masjid_db
AC_SERVICE_DB_USERNAME=root
AC_SERVICE_DB_PASSWORD=

AC_ANGGOTA_DB_HOST=127.0.0.1
AC_ANGGOTA_DB_PORT=3306
AC_ANGGOTA_DB_CONNECTION=mysql
AC_ANGGOTA_DB_DATABASE=ac_anggota_db
AC_ANGGOTA_DB_USERNAME=root
AC_ANGGOTA_DB_PASSWORD=

INVENTORY_DB_HOST=127.0.0.1
INVENTORY_DB_PORT=3306
INVENTORY_DB_CONNECTION=mysql
INVENTORY_DB_DATABASE=inventory_db
INVENTORY_DB_USERNAME=root
INVENTORY_DB_PASSWORD=

SESSION_DRIVER=file
SESSION_CONNECTION=
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.ac_beneran_final.test

AC_SERVICE_DOMAIN=ac.ac_beneran_final.test
AC_MASJID_MUSHOLLA_DOMAIN=
AC_ANGGOTA_DOMAIN=
INVENTORY_DOMAIN=inventory.ac_beneran_final.test
FUTURE_MODULE_DOMAIN=future.ac_beneran_final.test

# Shared session cookie across subdomains (SSO-style): set leading dot, e.g. .main.test
# SESSION_DOMAIN is already set above — keep parent domain consistent with all module hosts.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#------------------------------------------------------------------------------
# Internal Payment Configuration
#------------------------------------------------------------------------------
PAYMENT_TRANSFER_BANK_NAME=
PAYMENT_TRANSFER_ACCOUNT_NUMBER=
PAYMENT_TRANSFER_ACCOUNT_NAME=
PAYMENT_QRIS_MERCHANT_NAME="Forkis"
PAYMENT_QRIS_MERCHANT_CITY="Bekasi"
PAYMENT_QRIS_PAYLOAD=
PAYMENT_QRIS_IMAGE_URL=
PAYMENT_QRIS_GENERATOR_URL="https://api.qrserver.com/v1/create-qr-code/"
PAYMENT_QRIS_GENERATOR_SIZE=320

#------------------------------------------------------------------------------
# Security Configuration
#------------------------------------------------------------------------------
# Session security settings
SESSION_HTTP_ONLY=true
SESSION_EXPIRE_ON_CLOSE=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Cache prefix for multi-tenant environments
# CACHE_PREFIX=forkis_cache_

# Additional security headers configuration
SECURITY_HEADERS_ENABLED=true
CSP_REPORT_URI=

# HSTS settings (only for production with HTTPS)
# STRICT_TRANSPORT_SECURITY=max-age=31536000; includeSubDomains; preload
